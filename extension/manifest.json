{
  "manifest_version": 3,
  "name": "ADBCast Android TV",
  "version": "1.1.0",
  "description": "Control multiple Android TV devices from your browser using ADB—no TV app required.",
  "homepage_url": "https://www.iyc.com.tr/",
  "author": {
    "email": "fatihsahinsen@outlook.com"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ADBCast Android TV",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}