{
  "manifest_version": 3,
  "name": "AxenCast - AOSP TV Bridge Connector",
  "version": "1.1.0",
  "description": "Stream web pages, YouTube videos, multi-file media, and automated slideshow loops directly to Android TV / AOSP devices via local ADB bridge.",
  "homepage_url": "https://www.iyc.com.tr/",
  "author": {
    "email": "fatihsahinsen@outlook.com"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AxenCast TV Bridge Connector",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}